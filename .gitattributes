# Normalise line endings: LF in the repository, native in the working tree
* text=auto

*.py   text
*.md   text
*.txt  text
*.iss  text
*.spec text
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files: never convert, never diff as text
*.png  binary
*.gif  binary
*.jpg  binary
*.ico  binary
*.wav  binary
*.onnx binary
*.gguf binary
